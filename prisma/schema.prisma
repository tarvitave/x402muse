// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Painting {
  id            String   @id
  source        String?
  category      String   @default("painting")
  title         String
  artist        String
  imageUrl      String
  thumbnailPath String?
  active        Boolean  @default(true)
  hints         Hint[]
  createdAt     DateTime @default(now())
}

model Hint {
  id         String   @id
  paintingId String
  label      String
  content    String
  costSol    Float    @default(0.00001)
  isLocked   Boolean  @default(true)
  painting   Painting @relation(fields: [paintingId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id
  name      String
  email     String?
  createdAt DateTime @default(now())
  scores    Score[]
  payouts   Payout[]
}

model Score {
  id         String   @id @default(uuid())
  userId     String
  paintingId String
  mode       String
  points     Int
  hintsUsed  Int      @default(0)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model HintPayment {
  id          String   @id @default(uuid())
  userId      String
  hintId      String
  amountSol   Float
  txSignature String
  createdAt   DateTime @default(now())
}

model Payout {
  id          String   @id @default(uuid())
  userId      String
  amountSol   Float
  txSignature String?
  weekStart   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())
}

model MailingList {
  id          String               @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime             @default(now())
  contacts    MailingListContact[]
  campaigns   EmailCampaign[]
}

model MailingListContact {
  id            String      @id @default(uuid())
  mailingListId String
  email         String
  name          String?
  bounceType    String?     // 'soft' | 'hard' | null
  bouncedAt     DateTime?
  createdAt     DateTime    @default(now())
  mailingList   MailingList @relation(fields: [mailingListId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id                 String      @id @default(uuid())
  mailingListId      String
  subject            String
  bodyMarkdown       String
  fromName           String
  fromEmail          String
  status             String      @default("draft")
  sendRatePerMinute  Int         @default(60)
  totalSent          Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  mailingList        MailingList @relation(fields: [mailingListId], references: [id])
  sends              EmailSend[]
}

model EmailSend {
  id           String        @id @default(uuid())
  campaignId   String
  email        String
  name         String?
  status       String        @default("pending")
  bounceType   String?       // 'soft' | 'hard' | null
  error        String?
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
